# ─────────────────────────────────────────────────────────────────────────────
# qdisk — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Build outputs
bin/
obj/
tools/log/
__pycache__/
*.py[cod]

# Distribuição / release local
dist/

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# Certificados e assinatura digital
# Todo o conteúdo de tools/certs/ é privado — apenas .gitkeep é versionado.
tools/certs/*
!tools/certs/.gitkeep
!tools/certs/extract_cert_chain.ps1
*.pfx
*.p12
*.cer
*.spc
*.pvk

# Artefatos de publicação
Publish/
publish/

# Pastas de ferramentas externas baixadas localmente
# (rufus, etcher, rpi-imager, SDFormatter — fontes externas, não versionadas)
temp/

# OS
Thumbs.db
.DS_Store
Desktop.ini

# Logs locais
*.log
log/
logs/

# Sync local (contém remote, e-mail e active — dados de ambiente)
config/github_sync.ini

# Segredos locais (senhas de assinatura e de publicacao). Modelo: config/secret.md.example
config/secret.md
secret.txt

# Publicação local do atualizador (pode conter credenciais)
tools/utils/publish_update_package.ps1

# Especstory (chat history local)
.specstory/


# Configuracao local do Claude Code
.claude/settings.local.json
